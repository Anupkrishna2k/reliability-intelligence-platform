          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(orders_api_http_request_duration_seconds_bucket[5m])))",
          "instant": false,
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
