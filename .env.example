# Copy to .env and adjust as needed. Environment variables always win.
# Every value below is the built-in default.

# Service identity
ORDERS_API_APP_NAME=orders-api
ORDERS_API_APP_VERSION=1.0.0
ORDERS_API_ENVIRONMENT=development
ORDERS_API_DEBUG=false

# HTTP server binding
ORDERS_API_HOST=0.0.0.0
ORDERS_API_PORT=8000

# Logging: level is one of CRITICAL/ERROR/WARNING/INFO/DEBUG, format is json or text
ORDERS_API_LOG_LEVEL=INFO
ORDERS_API_LOG_FORMAT=json

# Metrics
ORDERS_API_METRICS_ENABLED=true
ORDERS_API_METRICS_PATH=/metrics
# /health, /ready and /metrics are excluded from the request metrics unless this is true
ORDERS_API_METRICS_INCLUDE_PROBES=false

# Service-level objectives (SLOs) and the rolling reliability window.
# Availability and latency targets are ratios in (0, 1); the latency threshold
# is in milliseconds. The window is the rolling period the SLIs are evaluated
# over. See the README for the availability/latency policies and error budget.
ORDERS_API_SLO_AVAILABILITY_TARGET=0.995
ORDERS_API_SLO_LATENCY_TARGET=0.95
ORDERS_API_SLO_LATENCY_THRESHOLD_MS=500
ORDERS_API_SLO_WINDOW_SECONDS=300
# An SLO still meeting its target is flagged "at_risk" once less than this
# fraction of its allowed error budget remains (0.25 = 75% consumed).
ORDERS_API_SLO_AT_RISK_BUDGET_REMAINING=0.25
ORDERS_API_RELIABILITY_PATH=/api/reliability

# Incident detection and lifecycle. The detector evaluates the reliability
# window on a timer and opens/resolves in-memory incident records. Incident
# state is process-local and lost on restart. See the README for the rules.
ORDERS_API_INCIDENT_DETECTION_ENABLED=true
ORDERS_API_INCIDENT_EVALUATION_INTERVAL_SECONDS=15
# Consecutive healthy evaluations required before a breached incident resolves.
ORDERS_API_INCIDENT_RECOVERY_EVALUATIONS=2
# Consumed error-budget multiple at or above which an availability incident is
# "critical" rather than "warning" (1.0 = budget exhausted).
ORDERS_API_INCIDENT_CRITICAL_BUDGET_CONSUMED=1.0
ORDERS_API_INCIDENT_HISTORY_LIMIT=500
ORDERS_API_INCIDENTS_PATH=/api/incidents

# Failure injection (local development / demo only).
# Off by default, and the service refuses to start if this is enabled in a
# production environment. When on, the control API is mounted at the path below.
ORDERS_API_FAILURE_INJECTION_ENABLED=false
ORDERS_API_FAILURE_INJECTION_PATH=/admin/failure

# API behaviour
ORDERS_API_API_PREFIX=/api
ORDERS_API_DEFAULT_PAGE_SIZE=20
ORDERS_API_MAX_PAGE_SIZE=100
